{
  "expo": {
    "name": "Papierkram",
    "slug": "papierkram",
    "scheme": "papierkram",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.naujocks.papierkram",
      "infoPlist": {
        "NSCameraUsageDescription": "Zum Abfotografieren deiner Briefe. Die Aufnahmen bleiben auf diesem Gerät.",
        "NSPhotoLibraryUsageDescription": "Um bereits vorhandene Fotos von Briefen zu importieren.",
        "NSFaceIDUsageDescription": "Zum Entsperren deiner Finanzdaten."
      }
    },
    "android": {
      "package": "com.naujocks.papierkram",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "./plugins/withMlKitNurLatein",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "cover",
          "backgroundColor": "#0D0D0D",
          "dark": {
            "image": "./assets/splash.png",
            "backgroundColor": "#0D0D0D"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
